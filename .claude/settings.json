{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh .claude/Invoke-ScriptAnalyzerOnChanged.ps1",
            "statusMessage": "Running ScriptAnalyzer on modified PS files"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh .claude/Invoke-ScriptAnalyzerOnChanged.ps1",
            "async": true,
            "statusMessage": "Running ScriptAnalyzer on modified PS files"
          }
        ]
      }
    ]
  }
}
